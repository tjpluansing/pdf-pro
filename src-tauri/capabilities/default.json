{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: native Save dialog, writing the file the user picked, and installing app updates",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart"
  ]
}
